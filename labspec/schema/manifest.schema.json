{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/araeies/bastionworks-labs/labspec/schema/manifest.schema.json",
  "title": "Bastionworks lab manifest",
  "description": "One lab package, two consumers: bw reads kit/*, the Verifier reads checkpoints/*. Trust levels are derived from the method and are never declared.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "version", "title", "track", "level", "estimatedMinutes",
    "learnerCostEstimateUsd", "mitre", "mcsb", "scenario", "kit", "hints", "checkpoints", "debrief"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "minLength": 3, "maxLength": 40 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "title": { "type": "string", "minLength": 5, "maxLength": 100 },
    "track": {
      "enum": [
        "playground", "rbac-attack-paths", "data-protection", "network-security", "entra-id",
        "detection-engineering", "incident-response", "guardrails-as-code", "cloud-app-security", "devsecops", "capstone"
      ]
    },
    "level": { "enum": ["beginner", "intermediate"] },
    "estimatedMinutes": { "type": "integer", "minimum": 5, "maximum": 480 },
    "learnerCostEstimateUsd": { "type": "number", "minimum": 0, "maximum": 5 },
    "mitre": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$" },
          "name": { "type": "string", "minLength": 3, "maxLength": 100 }
        }
      }
    },
    "mcsb": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z]{2,3}-[0-9]{1,2}$" }
    },
    "scenario": { "$ref": "#/$defs/relativePath" },
    "kit": { "$ref": "#/$defs/kit" },
    "hints": { "type": "array", "items": { "$ref": "#/$defs/relativePath" }, "maxItems": 10 },
    "checkpoints": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/checkpoint" } },
    "debrief": { "type": "string", "pattern": "^private:[a-z0-9/_.-]+\\.md$" }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"
    },
    "kit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope"],
      "description": "scope none: a lab with nothing to deploy (it brings its own data). Otherwise template, cleanup, names and outOfGroup are required (enforced by labspec lint).",
      "properties": {
        "scope": { "enum": ["resourceGroup", "subscription", "none"] },
        "template": { "$ref": "#/$defs/relativePath" },
        "parameters": { "type": "object" },
        "seed": { "$ref": "#/$defs/relativePath" },
        "selfChecks": { "$ref": "#/$defs/relativePath" },
        "cleanup": { "$ref": "#/$defs/relativePath" },
        "names": {
          "type": "object",
          "description": "Seed-derived names. bw and the Verifier compute identical values with labspec.seed.derive_name.",
          "additionalProperties": { "$ref": "#/$defs/derivedName" }
        },
        "outOfGroup": {
          "type": "array",
          "description": "Objects the kit creates outside its resource group; bw cleanup must remove each one.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "description"],
            "properties": {
              "type": { "enum": ["roleAssignment", "entraApplication", "policyAssignment", "budget", "keyVaultSoftDeleted", "subscriptionTag"] },
              "description": { "type": "string", "minLength": 5, "maxLength": 200 }
            }
          }
        }
      }
    },
    "derivedName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefix", "length"],
      "properties": {
        "prefix": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,15}$" },
        "length": { "type": "integer", "minimum": 4, "maximum": 20 },
        "alphabet": { "enum": ["lower-alnum", "hex"] }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "method", "submit"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 40 },
        "title": { "type": "string", "minLength": 5, "maxLength": 120 },
        "method": { "enum": ["hiddenDataset", "externalProbe", "artefactScan", "rubricReview", "knowledgeCheck", "selfIssuedToken"] },
        "submit": { "enum": ["url", "leakedSasUrl", "issuedSasUrl", "repoAtCommit", "text", "answers", "token"] },
        "hostSuffixes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^\\.([a-z0-9-]+\\.)*(windows\\.net|azure\\.com|azurewebsites\\.net|azurecontainerapps\\.io)$" }
        },
        "hostName": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]*$", "description": "Key into kit.names: the probed host's first label must equal this derived name." },
        "probePath": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9._~/-]{0,100}$",
          "description": "externalProbe: the path probed on the submitted host. The submitted URL then only names the host (still the learner's seed-derived name)."
        },
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 100, "maximum": 599 } },
            "errorCode": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z]+$" } },
            "bodyContainsDerived": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]*$" },
            "bodyExcludesDerived": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]*$", "description": "The body must NOT contain this seed-derived token: planted data that must no longer be served." },
            "headers": {
              "type": "object",
              "description": "Response headers that must be present, each matching a regular expression. Names are case-insensitive.",
              "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 200 }
            },
            "corsDenies": { "type": "string", "pattern": "^https://[a-z0-9.-]+$", "description": "Sent as Origin: the response must not allow it (no matching Access-Control-Allow-Origin, and no '*')." },
            "also": {
              "type": "array",
              "maxItems": 4,
              "description": "More requests to the same host. Plain http only for the HTTP-to-HTTPS redirect check on '/' (labspec lint).",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["scheme", "path", "status"],
                "properties": {
                  "scheme": { "enum": ["http", "https"] },
                  "path": { "type": "string", "pattern": "^/[A-Za-z0-9._~/-]{0,100}$" },
                  "status": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 100, "maximum": 599 } },
                  "locationPrefix": { "type": "string", "pattern": "^https://[A-Za-z0-9.{}/_-]+$", "description": "The Location header must start with this; {host} is the probed host." }
                }
              }
            }
          }
        },
        "redactAfterUse": { "type": "boolean" },
        "maxValidityMinutes": { "type": "integer", "minimum": 1, "maximum": 60 },
        "rules": { "type": "array", "items": { "type": "string", "pattern": "^(psrule|checkov|custom):[A-Za-z0-9_.-]+$" } },
        "rubric": { "$ref": "#/$defs/relativePath", "description": "Published rubric (brief 4.3); calibration sets stay in verifier-private." },
        "dataset": { "type": "string", "pattern": "^private:[a-z0-9/_.-]+$" },
        "questions": { "type": "string", "pattern": "^private:[a-z0-9/_.-]+$" },
        "questionsFile": { "$ref": "#/$defs/relativePath", "description": "knowledgeCheck: the PUBLIC questions (no answers) shown to learners; the answer key is the private `questions` reference (platform ADR-0028)." },
        "repoFile": { "$ref": "#/$defs/relativePath", "description": "For repoAtCommit submissions: the file in the learner's repo this checkpoint reads (for example detections/password-spray.kql). rubricReview defaults to incident-note.md." },
        "positiveControl": {
          "type": "string",
          "minLength": 10,
          "maxLength": 300,
          "description": "How this checkpoint proves the work was done, not merely that a resource vanished (verification-methods.md)."
        }
      }
    }
  }
}
